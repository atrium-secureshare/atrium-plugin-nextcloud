# Node / frontend build
node_modules/
js/

# Release archives built by scripts/package.sh
dist/

# Browser l10n catalogs: generated from l10n/*.json (the versioned source) at
# build time by scripts/gen-l10n-js.mjs (npm run l10n:build).
l10n/*.js

# PHP dependencies (rebuilt at build time from composer.lock)
vendor/

# Third-party license notices (generated at build time by scripts/collect-licenses.sh)
THIRD-PARTY-LICENSES

# PHPUnit result cache
.phpunit.cache/

# Local env / editor
.env
*.local
.DS_Store

# Scratch area for vendored upstream reference source (Nextcloud server, etc.)
temp/
