# @nextcloud/webpack-vue-config@7 peer-depends on @babel/core@^7 and
# webpack-dev-server@^5, while this app pins the newer @babel/core@8 / webpack
# tooling. The combination is known-good; legacy-peer-deps makes both
# `npm install` and `npm ci` resolve it consistently. Build peers
# that this therefore does not auto-install (node-polyfill-webpack-plugin,
# linkifyjs) are declared explicitly in devDependencies.
legacy-peer-deps=true
